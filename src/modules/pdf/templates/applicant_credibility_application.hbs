  <body>
    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Applicant's credibility application</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">In the matter of the guardianship of</p></div>
                <div class="input-field">{{caseDetailsStep.guardianName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Case number</div></div>
                <div class="input-field">{{caseDetailsStep.caseNumber}}</div>
              </div>
            </div>
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Name of applicant to be appointed guardian</p></div>
                <div class="input-field">{{applicantInformStep.applicantName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Date of birth</div></div>
                <div class="input-field">{{applicantInformStep.dob}}</div>
              </div>
            </div>
          </div>
          <div class="text-block" style="margin-top: 30px;">
            <p><strong>Applicant address</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">Current street address (city, zip code, state)</p></div>
                <div class="input-field">
                  {{applicantInformStep.applicantAddress.streetAddress}},
                  {{applicantInformStep.applicantAddress.city}},
                  {{applicantInformStep.applicantAddress.state}},
                  {{applicantInformStep.applicantAddress.zip}}
                </div>

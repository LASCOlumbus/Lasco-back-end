<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="css/style.css">
    <style>
        {{{inlineResetStyles}}}
        {{{inlineStyles}}}
    </style>
</head>
<body>
    <div class="page">
        <header>
            <div class="text--right txt txt--xs">PC-G-17.0G (Rev. 5-2019)</div>
            <div class="text--center">
                <h2 class="mt-16 uppercase">PROBATE COURT OF FRANKLIN COUNTY, OHIO</h2>
                <h4 class="uppercase">JEFFREY D. MACKEY, JUDGE</h4>
            </div>
        </header>
        <div class="content">
            <div class="flex v--end h--start gap-4">
                <div class="txt txt--m uppercase w-auto">
                    <p>IN THE MATTER OF THE GUARDIANSHIP OF</p>
                </div>
                <div class="input fullw">{{caseDetailsStep.guardianName}}</div>
            </div>
            <div class="flex v--end h--start gap-4 mt-16">
                <div class="txt txt--m uppercase w-auto">
                    <p>CASE NO.</p>
                </div>
                <div class="input w-auto mw-200">{{caseDetailsStep.caseNumber}}</div>
            </div>
            <div class="text--center mt-16">
                <h2>APPLICANT'S CREDIBILITY APPLICATION</h2>
            </div>
            <div class="mt-16 grid gap-10">
              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Name of Prospective Ward</div>
                <div class="input fullw">{{caseDetailsStep.nameOfProspectiveWard}}</div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Name of Applicant to be Appointed Guardian</div>
                <div class="input w-55">{{applicantInformStep.applicantName}}</div>
                <div class="txt txt--s w-auto">Date of Birth</div>
                <div class="input mw-100">{{applicantInformStep.dob}}</div>
              </div>
              <div class="flex v--end h--betweengap-4">
                <div class="txt txt--s w-auto">Applicant's Current Address</div>
                <div class="input fullw">
                  {{applicantInformStep.applicantAddress.streetAddress}},
                  {{applicantInformStep.applicantAddress.city}},
                  {{applicantInformStep.applicantAddress.state}},
                  {{applicantInformStep.applicantAddress.zip}}
                </div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="input fullw"></div>
                <div class="txt txt--s w-auto">From</div>
                <div class="input mw-200 small-text w-auto">{{applicantInformStep.applicantAddress.from}}</div>
              </div>

              <div class="flex v--end h--betweengap-4">
                <div class="txt txt--s w-auto">Previous Address (If less than 5 years at present address)</div>
                <div class="input fullw"></div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="input fullw">{{applicantInformStep.applicantAddress.previousAddresses.[0].address}}</div>
                <div class="txt txt--s w-auto">From/To</div>
                <div class="input mw-200 small-text w-auto">{{applicantInformStep.applicantAddress.previousAddresses.[0].from}} - {{applicantInformStep.applicantAddress.previousAddresses.[0].to}}</div>
              </div>

              <div class="flex v--end h--betweengap-4">
                <div class="txt txt--s w-auto">Previous Address</div>
                <div class="input fullw"></div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="input fullw">{{applicantInformStep.applicantAddress.previousAddresses.[1].address}}</div>
                <div class="txt txt--s w-auto">From/To</div>
                <div class="input mw-200 small-text w-auto">{{applicantInformStep.applicantAddress.previousAddresses.[1].from}} - {{applicantInformStep.applicantAddress.previousAddresses.[1].to}}</div>
              </div>

              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Spouse's Name</div>
                <div class="input fullw">{{familyAndEmploymentStep.marriage.spouseName}}</div>
                <div class="txt txt--s w-auto">Years Married</div>
                <div class="input mw-150">{{familyAndEmploymentStep.marriage.yearMarried}}</div>
              </div>

              <div class="flex v--end h--betweengap-4">
                <div class="txt txt--s w-auto">Address</div>
                <div class="input fullw">
                  {{familyAndEmploymentStep.marriage.spouseStreetAddress}},
                  {{familyAndEmploymentStep.marriage.state}},
                  {{familyAndEmploymentStep.marriage.state}},
                  {{familyAndEmploymentStep.marriage.zip}}
                </div>
              </div>

              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Applicant's Employer</div>
                <div class="input fullw">{{familyAndEmploymentStep.employment.currentEmployer}}</div>
                <div class="txt txt--s w-auto">From</div>
                <div class="input mw-200 small-text w-auto">{{familyAndEmploymentStep.employment.from}}</div>
              </div>
              <div class="txt txt--s mt-8">
                <p>Previous Employer (If less than 5 years at current employment )</p>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="input fullw">{{familyAndEmploymentStep.employment.previousEmployers.[0].employer}}</div>
                <div class="txt txt--s w-auto">From/To</div>
                <div class="input mw-200 small-text">{{familyAndEmploymentStep.employment.previousEmployers.[0].from}} - {{familyAndEmploymentStep.employment.previousEmployers.[0].to}}</div>
              </div>

              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Previous Employer</div>
                <div class="input w-55">{{familyAndEmploymentStep.employment.previousEmployers.[1].employer}}</div>
                <div class="txt txt--s w-auto">From</div>
                <div class="input mw-200 small-text">{{familyAndEmploymentStep.employment.previousEmployers.[1].from}} - {{familyAndEmploymentStep.employment.previousEmployers.[1].to}}</div>
              </div>

              <!--checkboxes-->
              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">Name of Applicant's Bank</div>
                <div class="input fullw">{{bankingInformStep.bankName}}</div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#includes bankingInformStep.accountType "checking"}}✓{{/includes}}</div>
                  <div class="txt txt--s">Checking</div>
                  <div class="checkbox ml-8">{{#includes bankingInformStep.accountType "savings"}}✓{{/includes}}</div>
                  <div class="txt txt--s">Savings</div>
                  <div class="checkbox ml-8">{{#includes bankingInformStep.accountType "safe_deposit_box"}}✓{{/includes}}</div>
                  <div class="txt txt--s">Safe Deposit Box</div>
                </div>
              </div>


              <div class="flex v--end h--start gap-10">
                <div class="txt txt--s w-auto">Has Applicant Ever Filed Bankruptcy?</div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverFiledBankruptcy true}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">Yes</div>
                  <div class="checkbox ml-8">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverFiledBankruptcy false}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">No</div>
                </div>
              </div>
              <div class="flex v--end h--start gap-10">
                <div class="txt txt--s w-auto">Has Applicant Ever Been Garnished?</div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenGarnished true}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">Yes</div>
                  <div class="checkbox ml-8">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenGarnished false}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">No</div>
                </div>
              </div>
              <div class="flex v--end h--start gap-10">
                <div class="txt txt--s w-auto">Has Applicant Ever Been in Receivership?</div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenInReceivership true}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">Yes</div>
                  <div class="checkbox ml-8">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenInReceivership false}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">No</div>
                </div>
              </div>
              <div class="flex v--end h--start gap-10">
                <div class="txt txt--s w-auto">Has Applicant Ever Been Convicted of a Felony? </div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenConvictedFelony true}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">Yes</div>
                  <div class="checkbox ml-8">{{#ifEquals legalAndFinancialHistoryStep.isApplicantEverBeenConvictedFelony false}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">No</div>
                </div>
              </div>
              <div class="flex v--end h--start gap-10">
                <div class="txt txt--s w-auto">Has Applicant Had Experience in Handling Investments in Marketable Securities?</div>
                <div class="flex v--start gap-4 h--between w-auto">
                  <div class="checkbox">{{#ifEquals legalAndFinancialHistoryStep.isApplicantHadExperienceHandlingInvestments true}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">Yes</div>
                  <div class="checkbox ml-8">{{#ifEquals legalAndFinancialHistoryStep.isApplicantHadExperienceHandlingInvestments false}}✓{{/ifEquals}}</div>
                  <div class="txt txt--s">No</div>
                </div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="txt txt--s w-auto">
                  <p>Explanation of any item checked "Yes" above:</p>
                </div>
                <div class="input fullw"></div>
              </div>
              {{#if legalAndFinancialHistoryStep.explanation}}
              <div class="flex v--end h--between gap-4">
                <div class="input fullw">{{legalAndFinancialHistoryStep.explanation}}</div>
              </div>
              {{else}}
              <div class="flex v--end h--between gap-4">
                <div class="input fullw">{{legalAndFinancialHistoryStep.explanation}}</div>
              </div>
              <div class="flex v--end h--between gap-4">
                <div class="input fullw"></div>
              </div>
              {{/if}}
            </div>

            <div class="text--left mt-10">
                <div class="txt txt--s">
                    <p>This statement is made in support of my application to be appointed Guardian in the above styled matter and the undersigned says that the facts stated in the foregoing applications are true.</p>
                </div>
            </div>

            <div class="mt-16 grid col-2 gap-20">
                <div class="col">
                </div>
                <div class="col">
                    <div class="row">
                        <div class="input fullw"></div>
                        <div class="txt txt--xs mt-4 text--center">Signature of Applicant</div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-auto">
            <div class="flex v--center h--between">
              <div class="txt txt--s">15.4</div>
              <div class="text--center fw-600 txt txt--s uppercase">
                FRANKLIN COUNTY FORM G-17.0G - APPLICANT'S CREDIBILITY APPLICATION
              </div>
              <div class="txt txt--s pr-20"></div>
            </div>
        </footer>
    </div>
</body>
</html>
  <body>
    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Next of Kin of Proposed Ward</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">In the matter of the guardianship of</p></div>
                <div class="input-field">{{caseDetailsStep.guardianName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Case number</div></div>
                <div class="input-field">{{caseDetailsStep.caseNumber}}</div>
              </div>
            </div>

          </div>
          <div class="text-block">
            <p>
              The following are the Prospective Ward’s spouse, living children, other next-of-kin, and current Guardian.
            </p>
            <p>
              <strong>NOTE:</strong> Specify age and birth date of each minor under 16 on the line containing the minor’s name. List the name and address of the minor’s parent, guardian or custodian on the name and address lines following the minor’s address.
            </p>
            <p>
              <strong>NOTE:</strong> Persons age 16 and 17 must be served via certified mail.
            </p>
          </div>
          <!--relative-->
          <div class="w100">
            <div class="text-block" style="margin-top: 10px;">
              <p><strong>Relative - 1</strong></p>
            </div>
            <div class="div-2">
              <div class="inputs-container">
                <div class="input" style="width: 100%;">
                  <div class="input-top-section"><p class="label">Full name of relative</p></div>
                  <div class="input-field">{{waiversListStep.relatives.[0].fullName}}</div>
                </div>
              </div>
              <div class="inputs-container">
                <div class="input">
                  <div class="input-top-section"><p class="label">Relationship to the Prospective Ward</p></div>
                  <div class="input-field">{{waiversListStep.relatives.[0].relationship}}</div>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <style>
      @import url("https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css");
* {
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}
html,
body {
  margin: 0px;
  height: 100%;
  font-family: "Inter-Regular", Helvetica;
}
/* a blue color as a generic focus style */
button:focus-visible {
  outline: 2px solid #4a90e2 !important;
  outline: -webkit-focus-ring-color auto 5px !important;
}
a {
  text-decoration: none;
}
.webcheck-waiver-PDF {
  width: 100%;
  aspect-ratio: 0.71;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.webcheck-waiver-PDF .header {
  display: flex;
  width: 100%;
  height: 59px;
  position: relative;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background-color: var(--tokens-surface-input-hover);
  border-top-style: none;
  border-right-style: none;
  border-bottom-width: 0.5px;
  border-bottom-style: solid;
  border-left-style: none;
  border-color: var(--tokens-border-secondary);
}

.webcheck-waiver-PDF .text-wrapper {
  position: relative;
  width: fit-content;
  font-family: "Inter-SemiBold", Helvetica;
  font-weight: 600;
  color: var(--tokens-text-primary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 160%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  text-align: left;
}

.webcheck-waiver-PDF .container {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 3px;
  position: relative;
  flex: 0 0 auto;
}

.webcheck-waiver-PDF .div {
  position: relative;
  width: fit-content;
  margin-top: -0.50px;
  font-family: "Inter-Regular", Helvetica;
  font-weight: 400;
  color: var(--tokens-text-primary);
  font-size: 10px;
  letter-spacing: 0;
  line-height: 150%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.webcheck-waiver-PDF .judge-jeffrey-d {
  position: relative;
  width: fit-content;
  font-family: "Inter-Regular", Helvetica;
  font-weight: 400;
  color: var(--tokens-text-primary);
  font-size: 10px;
  letter-spacing: 0;
  line-height: 150%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.webcheck-waiver-PDF .text-container {
  padding: 0 20px;
  width: 100%;
  height: 400px;
  margin-top: 24px;
  gap: 30px;
  display: flex;
  position: relative;
  flex-direction: column;
  align-items: flex-start;
}

.webcheck-waiver-PDF .div-2 {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
}

.webcheck-waiver-PDF .text-block {
  gap: 6px;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
  display: flex;
  position: relative;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.webcheck-waiver-PDF .p {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: left;
  align-self: stretch;
  margin-top: -0.50px;
  font-family: "Inter-Regular", Helvetica;
  font-weight: 400;
  color: var(--tokens-text-primary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 150%;
  text-align: left;
}

.webcheck-waiver-PDF .frame {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
}

.webcheck-waiver-PDF .inputs-container {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
}

.webcheck-waiver-PDF .input {
  flex-direction: column;
  width: 50%;
  align-items: flex-start;
  gap: 3px;
  z-index: 1;
  display: flex;
  position: relative;
}

.webcheck-waiver-PDF .input-top-section {
  display: flex;
  align-items: center;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
}

.webcheck-waiver-PDF .label {
  position: relative;
  display: -webkit-box;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-top: -0.50px;
  font-family: "Inter-Medium", Helvetica;
  font-weight: 600;
  color: var(--tokens-text-primary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 150%;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.webcheck-waiver-PDF .input-field {
  align-items: center;
  gap: var(--primitives-spacings-400);
  padding: 0 10px;
  height: 30px;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
  background-color: var(--tokens-surface-input);
  border-radius: 1px;
  border: 0.5px solid;
  border-color: var(--tokens-border-primary);
  display: flex;
  position: relative;
  font-size: 12px;
}

.webcheck-waiver-PDF .input-2 {
  flex-direction: column;
  width: 50%;
  align-items: flex-start;
  gap: 3px;
  z-index: 0;
  display: flex;
  position: relative;
}

.webcheck-waiver-PDF .input-3 {
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  flex: 1;
  flex-grow: 1;
  display: flex;
  position: relative;
}

.webcheck-waiver-PDF .input-field-2 {
  display: flex;
  align-items: center;
  gap: var(--primitives-spacings-400);
  padding: 8px;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
  background-color: var(--tokens-surface-input);
  border-radius: 1px;
  overflow: hidden;
  border: 0.5px solid;
  border-color: var(--tokens-border-primary);
}

.webcheck-waiver-PDF .placeholder-label {
  position: relative;
  display: -webkit-box;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-top: -0.50px;
  font-family: "Inter-Regular", Helvetica;
  font-weight: 400;
  color: var(--tokens-text-secondary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 150%;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.webcheck-waiver-PDF .inputs-container-2 {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  row-gap: 12px;
  position: relative;
  align-self: stretch;
  width: 100%;
  flex: 0 0 auto;
  flex-flow: row;
  flex-wrap: wrap;
}

.webcheck-waiver-PDF .input-4 {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  position: relative;
  z-index: 1;
  width: calc(50% - 3px);
}

.webcheck-waiver-PDF .label-wrapper {
  position: relative;
  align-self: stretch;
  width: 100%;
  border: none;
  background: none;
  display: -webkit-box;
  align-items: center;
  justify-content: center;
  flex: 1;
  margin-top: -0.50px;
  font-family: "Inter-Medium", Helvetica;
  font-weight: 500;
  color: var(--tokens-text-primary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 150%;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  padding: 0;
}

.webcheck-waiver-PDF .input-5 {
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  flex: 1;
  flex-grow: 1;
  z-index: 0;
  display: flex;
  position: relative;
}

.webcheck-waiver-PDF .text-wrapper-2 {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 20px;
  margin-top: auto;
  font-family: "Inter-Medium", Helvetica;
  font-weight: 500;
  color: var(--tokens-text-secondary);
  font-size: 12px;
  letter-spacing: 0;
  line-height: 150%;
  white-space: nowrap;
}

  <body>
    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Waiver of notice</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="div-2">
          <div class="text-block">
            <p class="p">
              You hereby waive the issuing and service of notice, voluntarily enter your appearance herein, and consent
              to the appointment of the person named below as guardian of the above-named person.
            </p>
          </div>
          <div class="frame">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">In the matter of the guardianship of</p></div>
                <div class="input-field">{{caseDetailsStep.guardianName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Case number</div></div>
                <div class="input-field">{{caseDetailsStep.caseNumber}}</div>
              </div>
            </div>
            <div class="inputs-container">
              <div class="input-3">
                <div class="input-top-section"><p class="label">Name of person asking to be the guardian</p></div>
                <div class="input-field">{{caseDetailsStep.applicantName}}</div>
              </div>
            </div>
          </div>
        </div>
        <div class="div-2">
          <p class="p">
            Add people who waive notice. These are the adults who agree they have been notified about the guardianship
            application and waive the notice. Type their full names below.
          </p>
          <div class="frame">
            <div class="inputs-container-2">
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[0]}}</div>
                </div>
              <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[1]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[2]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[3]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[4]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[5]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[6]}}</div>
                </div>
                <div class="input-4">
                  <p class="label">Name of person waiving notice</p>
                  <div class="input-field">{{waiversListStep.persons.[7]}}</div>
                </div>
            </div>
          </div>
        </div>
      </div>
      <div class="text-wrapper-2">PC-C-20.0C (REV. 3/2001)</div>
    </div>
  </body>

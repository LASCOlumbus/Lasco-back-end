            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input fullw">
                <div class="input-top-section"><p class="label">Place of conviction</p></div>
                <div class="input-field">{{legalDeclarationsStep.conviction.convictionPlace}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Has a guardian been nominated in writing, in a will or power of attorney?</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if legalDeclarationsStep.isGuardianHasBeenNominatedInWriting}}✓{{/if}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals legalDeclarationsStep.isGuardianHasBeenNominatedInWriting false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input fullw">
                <div class="input-top-section"><p class="label">If answer "Yes" provide the name of nominated person:</p></div>
                <div class="textarea-field">{{legalDeclarationsStep.nominatedPersonName}}</div>
              </div>
            </div>
          </div>
          <div class="text-block" style="margin-top: 30px;">
            <p><strong>Please check the items you are providing or confirming</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw" style="flex-direction: column; align-items: flex-start!important;
              gap: 10px">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if legalDeclarationsStep.isNominatedPersonContactInfoListedOnForm15}}✓{{/if}}
                  </div>
                  The nominated person’s contact information is listed on Form 15.0 – Next of Kin.
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if legalDeclarationsStep.isGuardianNominatedDocumentAttached}}✓{{/if}}
                  </div>
                  A copy of the document which nominates the guardian is attached.
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if legalDeclarationsStep.isNotAdmin}}✓{{/if}}
                  </div>
                  I am not an administrator, executor, or fiduciary of an estate in which the Prospective Ward is interested.
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if legalDeclarationsStep.isApplicantAgreed}}✓{{/if}}
                  </div>
                  I (applicant) represents that the address provided below is the Applicant's permanent address and acknowledges the requirement that the Court be notified of any change of address. Removal may result from failure to comply with this requirement.
                </div>
              </div>
            </div>
          </div>



            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">If answer "Yes" what's the language?</p></div>
                <div class="input-field">
                  {{wardInformStep.wardSpeakLanguage}}
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">List the prospective ward’s prescription and over-the-counter medications</p></div>
                <div class="textarea-field">
                  {{wardInformStep.wardPrescriptions}}
                </div>
              </div>
            </div>
          </div>
          <div class="div-2" style="margin-top: 40px;">
            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Has the prospective ward had military service?</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if wardInformStep.isWardHasMilitaryService}}✓{{/if}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals wardInformStep.isWardHasMilitaryService false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">

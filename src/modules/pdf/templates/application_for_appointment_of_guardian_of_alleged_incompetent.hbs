            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Does the prospective ward have a representative payee?</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals assetsAndIncomeStep.isWardHasRepresentativePayee true}}✓{{/ifEquals}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals assetsAndIncomeStep.isWardHasRepresentativePayee false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input fullw">
                <div class="input-top-section"><p class="label">If yes, list representative payee name & address:</p></div>
                <div class="textarea-field">{{assetsAndIncomeStep.payeeName}}, {{assetsAndIncomeStep.payeeAddress}}</div>
              </div>
            </div>
          </div>
          <div class="text-block">
            <p><strong>What should the guardian be responsible for? (check only one)</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals guardianshipTypeStep.guardianResponsibility "theProspectiveWardsPerson"}}✓{{/ifEquals}}
                  </div>
                  The prospective ward's person 
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals guardianshipTypeStep.guardianResponsibility "theProspectiveWardsProperty"}}✓{{/ifEquals}}
                  </div>
                  The prospective ward's property 
                </div>
              </div>
            </div>
          </div>
          <div class="text-block">
            <p><strong>Wha does the type of guardianship applied for?</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "personAndEstate"}}✓{{/includes}}
                  </div>
                  Person and estate
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "personOnly"}}✓{{/includes}}
                  </div>
                  Person only
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "estateOnly"}}✓{{/includes}}
                  </div>
                  Estate only
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "emergency"}}✓{{/includes}}
                  </div>
                  Emergency
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "interim"}}✓{{/includes}}
                  </div>
                  Interim
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "nonLimited"}}✓{{/includes}}
                  </div>
                  Non-limited
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes guardianshipTypeStep.typeGuardianship "limited"}}✓{{/includes}}
                  </div>
                  Limited
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input fullw">
                <div class="input-top-section"><p class="label">If limited guardianship applied for, tell what is the limited powers requested?</p></div>
                <div class="textarea-field">{{guardianshipTypeStep.limitedPowersRequested}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input f-auto w-auto" style="width: auto;">
                <div class="input-top-section f-auto w-auto"><p class="label">Time period requested</p></div>
                <div class="flex" style="padding-right: 24px;">
                  <div class="checkbox-wrap">
                    <div class="checkbox">
                      {{#ifEquals guardianshipTypeStep.timePeriodRequested "indefinite"}}✓{{/ifEquals}}
                    </div>
                    Indefinite
                  </div>
                  <div class="checkbox-wrap">
                    <div class="checkbox">
                      {{#ifEquals guardianshipTypeStep.timePeriodRequested "limited"}}✓{{/ifEquals}}
                    </div>
                    Limited to a specific time period
                  </div>
                </div>
              </div>
              <div class="input ml-auto fullw">
                <div class="input-top-section"><p class="label">Specify the time period, if limited to a specific period</p></div>
                <div class="input-field">
                  {{guardianshipTypeStep.specifyTimePeriod.start}}
                  {{#if guardianshipTypeStep.specifyTimePeriod.end}} - {{guardianshipTypeStep.specifyTimePeriod.end}}{{/if}}
                </div>
              </div>
            </div>
          </div>
          <div class="div-2" style="margin-top: 24px;">
            <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Full name of applicant</p></div>
                <div class="input-field">{{applicantInformStep.applicantName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Applicant date of birth</div></div>
                <div class="input-field">{{applicantInformStep.applicantDob}}</div>
              </div>
            </div>
          </div>
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Applicant phone number</p></div>
                <div class="input-field">{{applicantInformStep.applicantPhone}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Applicant email address</div></div>
                <div class="input-field">{{applicantInformStep.applicantEmail}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Applicant’s current address</p></div>
                <div class="input-field">{{applicantInformStep.applicantAddress}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Applicant’s relationship to the prospective ward</div></div>
                <div class="input-field">{{applicantInformStep.applicantRelationshipToWard}}</div>
              </div>
            </div>
          </div>
          <div class="text-block">
            <p><strong>Does the applicant require an interpreter to understand English?</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if applicantInformStep.isApplicantRequiringInterpreter}}✓{{/if}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals applicantInformStep.isApplicantRequiringInterpreter false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
                <div class="flex fullw" style="align-items: flex-end; margin-top: 0; padding-left: 20px;">
                  <div class="input-top-section f-auto w-auto" style="width: auto; flex: 0 0 auto; margin-top: 0;"><p class="label" style="font-weight: 400;">If yes, what's the language?</p></div>
                  <div class="text-wrappeer fullw" style="font-size: 12px;">
                    {{applicantInformStep.applicantSpeakLanguage}}
                    <div class="line fullw" style="width: 100%; align-self: unset; margin-top: 0;"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
      <div class="text-wrapper-2"><p>PC- G- 16.1B (REV. 8-2014)</p><p>Page - 2</p></div>
    </div>





    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Application for appointment of guardian of alleged incompetent</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>

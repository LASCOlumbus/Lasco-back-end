            </div>
          </div>
        </div>
      </div>
      <div class="text-wrapper-2"><p>PC- G- 16.1B (REV. 8-2014)</p><p>Page - 1</p></div>
    </div>



    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Application for appointment of guardian of alleged incompetent</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">

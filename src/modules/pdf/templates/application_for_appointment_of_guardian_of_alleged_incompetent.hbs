              <label for="applicant-signature" class="label-2">Applicant signature</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Type of printed name</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Address</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">City, State, Zip code</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Telephone number</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Applicant signature</label>
            </div>
          </div>
        </div>
        <div class="text-wrapper-2"><p>PC- G- 16.1B (REV. 8-2014)</p><p>Page - 3</p></div>
      </section>
    </div>

                <div class="input-top-section"><div class="label">Branch of service</div></div>
                <div class="input-field">{{wardInformStep.militaryService.branchService}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Start dates of service</p></div>
                <div class="input-field">{{wardInformStep.militaryService.startDateOfService}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">End dates of service</div></div>
                <div class="input-field">{{wardInformStep.militaryService.endDateOfService}}</div>

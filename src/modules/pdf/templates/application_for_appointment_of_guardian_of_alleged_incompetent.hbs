  <body>
    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Application for appointment of guardian of alleged incompetent</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">In the matter of the guardianship of</p></div>
                <div class="input-field">{{caseDetailsStep.guardianName}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Case number</div></div>
                <div class="input-field">{{caseDetailsStep.caseNumber}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Relationship to the ward (check only one)</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals caseDetailsStep.relationshipToWard "initialAppointment"}}✓{{/ifEquals}}
                  </div>
                  Initial appointment
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals caseDetailsStep.relationshipToWard "successorAppointment"}}✓{{/ifEquals}}

          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Estimated value of personal property</p></div>
                <div class="input-field">{{assetsAndIncomeStep.estimatedValuePersonalProperty}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Estimated value of real estate</div></div>
                <div class="input-field">{{assetsAndIncomeStep.estimatedValueRealEstate}}</div>
              </div>

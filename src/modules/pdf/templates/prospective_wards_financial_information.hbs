  <body>
    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Prospective ward's financial information</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="div-2">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">In the matter of the guardianship of</p></div>
                <div class="input-field">{{caseDetailsStep.inTheMatterOfTheGuardianshipOf}}</div>
              </div>
              <div class="input-2">
                <div class="input-top-section"><div class="label">Case number</div></div>
                <div class="input-field">{{caseDetailsStep.caseNumber}}</div>
              </div>
            </div>
          </div>
          <div class="text-block" style="margin-top: 30px;">
            <p>Which benefits does the prospective ward receive?</p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "socialSecurity"}}✓{{/includes}}
                  </div>
                  Social security
                </div>
                <div class="input ml-auto">
                  <div class="input-field">
                    {{benefitsStep.socialSecurity.socialSecuritySize}}
                  </div>
                </div>
                <p class="label f-auto">per month</p>
              </div>
            </div>
          </div>

          <div class="div-2 pl-24">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">Representative payee name for Social security (if there is one):</p></div>
                <div class="input-field">
                  {{benefitsStep.socialSecurity.representativePayeeName}}
                </div>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "PERS"}}✓{{/includes}}
                  </div>
                  P.E.R.S.
                </div>
                <div class="input ml-auto">
                  <div class="input-field">
                    {{benefitsStep.PERS.size}}
                  </div>
                </div>
                <p class="label f-auto">per month</p>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "VABenefits"}}✓{{/includes}}
                  </div>
                  V.A. benefits
                </div>
                <div class="input ml-auto">
                  <div class="input-field">
                    {{benefitsStep.VABenefits.size}}
                  </div>
                </div>
                <p class="label f-auto">per month</p>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "railroadRetirement"}}✓{{/includes}}
                  </div>
                  Railroad retirement
                </div>
                <div class="input ml-auto">
                  <div class="input-field">
                    {{benefitsStep.railroadRetirement.size}}
                  </div>
                </div>
                <p class="label f-auto">per month</p>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "otherPension"}}✓{{/includes}}
                  </div>
                  Other pension(s)
                </div>
                <div class="input ml-auto">
                  <div class="input-field">
                    {{benefitsStep.otherPension.describeOtherPensionSize}}
                  </div>
                </div>
                <p class="label f-auto">per month</p>
              </div>
            </div>
          </div>

          <div class="div-2 pl-24">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">Source of other pension(s)</p></div>
                <div class="input-field">
                  {{benefitsStep.otherPension.sourceOfOtherPension}}
                </div>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="flex fullw">
              <div class="checkbox-wrap">
                <div class="checkbox">
                  {{#includes benefitsStep.benefit "medicaid"}}✓{{/includes}}
                </div>
                <strong>Medicaid</strong>
              </div>
            </div>
            <div class="flex fullw pl-24">
              <div class="checkbox-wrap">
                <div class="checkbox">
                  {{#if benefitsStep.medicaid.isWardMedicaidFacilityResident}}✓{{/if}}
                </div>
                The prospective ward is eligible for Medicaid and lives in a nursing home or other facility which receives all of the prospective ward's income.
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "otherInsuranceBenefits"}}✓{{/includes}}
                  </div>
                  Other insurance benefits:
                </div>
                <div class="input fullw">
                  <div class="input-field">
                    {{benefitsStep.otherInsuranceBenefits.description}}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes benefitsStep.benefit "other"}}✓{{/includes}}
                  </div>
                  Other:
                </div>
                <div class="input fullw">
                  <div class="input-field">
                    {{benefitsStep.other.description}}
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="text-block" style="margin-top: 30px;">
            <p><strong>Financial account-1</strong></p>
          </div>
          <div class="div-2" style="margin-top: 0;">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Institution (png, fidelity)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[0].institution}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Type (checking, brokerage)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[0].type}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Estimated balance</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[0].estimatedBalance}}</div>
              </div>
            </div>
          </div>
          <div class="text-block" style="margin-top: 16px;">
            <p><strong>Financial account-2</strong></p>
          </div>
          <div class="div-2" style="margin-top: 0;">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Institution (png, fidelity)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[1].institution}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Type (checking, brokerage)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[1].type}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Estimated balance</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[1].estimatedBalance}}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="text-wrapper-2"><p>PC- G- 17.0F (REV. 8-2025)</p><p>Page - 1</p></div>
    </div>



    <div class="webcheck-waiver-PDF">
      <header class="header">
        <div class="text-wrapper">Prospective ward's financial information</div>
        <div class="container">
          <p class="div">Probate court of Franklin County, Ohio</p>
          <p class="judge-jeffrey-d">Judge: Jeffrey D. Mackey</p>
        </div>
      </header>
      <div class="text-container">
        <div class="frame">
          <div class="text-block" style="margin-top: 30px;">
            <p><strong>Financial account-3</strong></p>
          </div>
          <div class="div-2" style="margin-top: 0;">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Institution (png, fidelity)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[2].institution}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Type (checking, brokerage)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[2].type}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Estimated balance</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[2].estimatedBalance}}</div>
              </div>
            </div>
          </div>
          <div class="text-block" style="margin-top: 16px;">
            <p><strong>Financial account-4</strong></p>
          </div>
          <div class="div-2" style="margin-top: 0;">
            <div class="inputs-container">
              <div class="input">
                <div class="input-top-section"><p class="label">Institution (png, fidelity)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[3].institution}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Type (checking, brokerage)</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[3].type}}</div>
              </div>
              <div class="input">
                <div class="input-top-section"><p class="label">Estimated balance</p></div>
                <div class="input-field">{{financialAccountStep.accounts.[3].estimatedBalance}}</div>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Does the prospective ward own real estate?</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if propertyStep.isProspectiveWardRealEstateOwner}}✓{{/if}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals propertyStep.isProspectiveWardRealEstateOwner false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">If answer "Yes", what's the real estate address(es):</p></div>
                <div class="input-field">{{propertyStep.realEstateAddress}}</div>
              </div>
            </div>
          </div>

          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <p class="label f-auto">Does the prospective ward receive rental income?</p>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#if propertyStep.prospectiveWardReceivesRentalIncome}}✓{{/if}}
                  </div>
                  Yes
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals propertyStep.prospectiveWardReceivesRentalIncome false}}✓{{/ifEquals}}
                  </div>
                  No
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">If answer "Yes", what's the rental income amount (per month)</p></div>
                <div class="input-field">{{propertyStep.rentalIncomeAmount}}</div>
              </div>
            </div>
          </div>

          <div class="text-block">
            <p><strong>Is the prospective ward a beneficiary of any of the following (check all that apply)?</strong></p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes assetsInterests.prospectiveWardBeneficiaryOf "specialNeedsTrust"}}✓{{/includes}}
                  </div>
                  Special needs trust
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes assetsInterests.prospectiveWardBeneficiaryOf "otherTrust"}}✓{{/includes}}
                  </div>
                  Any other trust
                </div>
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#includes assetsInterests.prospectiveWardBeneficiaryOf "decedentEstate"}}✓{{/includes}}
                  </div>
                  Decedent’s estate
                </div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">Identifying information of the estate or trust (name of decedent or settlor, case number, court overseeing the trust or estate)</p></div>
                <div class="textarea-field">{{assetsInterests.identifyingInformation}}</div>
              </div>
            </div>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="input" style="width: 100%;">
                <div class="input-top-section"><p class="label">Source and amount of other income or assets (cash, securities, royalties, etc.):</p></div>
                <div class="input-field">{{assetsInterests.sourceOfIncomeOrAsset}} {{assetsInterests.amountOfIncomeOrAsset}}</div>
              </div>
            </div>
          </div>

          <div class="text-block" style="margin-top: 20px;">
            <p><strong>Application to Determine Indigent Status. (Request to Avoid Court Costs for Prospective Ward)</strong></p>
            <p>Based on the financial information above, I believe that the prospective ward:</p>
          </div>
          <div class="div-2">
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals assetsInterests.hasSufficientFundsToPayCourtCosts true}}✓{{/ifEquals}}
                  </div>
                  Has enough funds available in their own name to pay court costs.
                </div>
              </div>
            </div>
            <div class="inputs-container">
              <div class="flex fullw">
                <div class="checkbox-wrap f-auto">
                  <div class="checkbox">
                    {{#ifEquals assetsInterests.doesNotHaveSufficientFundsToPayCourtCosts true}}✓{{/ifEquals}}
                  </div>
                  Does not have enough funds in their own name to pay court costs. <br>The court should consider whether the proposed ward can be considered indigent.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <section class="frame">
        <div class="frame-2">
          <div class="frame-3">
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Date - month - year</label>
            </div>
          </div>
          <div class="frame-3">
            <div class="input-4">
              <div class="text-field">{{caseDetailsStep.applicantName}}</div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Affiant/Applicant</label>
            </div>
            <div class="input-4">
              <div class="text-field"></div>
              <div class="line"></div>
              <label for="applicant-signature" class="label-2">Notary Public/Deputy Clerk</label>
            </div>
          </div>
        </div>
        <div class="text-wrapper-2"><p>PC- G- 17.0F (REV. 8-2025)</p><p>Page - 2</p></div>
      </section>
    </div>
  </body>
</html>
